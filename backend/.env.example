MONGODB_URI=mongodb://localhost:27017/ekoolie
PORT=5000
NODE_ENV=development

# Deployed frontend origin (Vercel/Netlify) — required in production for CORS
# and cookie SameSite handling. Leave blank for local dev.
FRONTEND_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Sign up at https://railkit.rajivdubey.dev for a free-tier key (50 req/month)
RAILKIT_API_KEY=
RAILKIT_MOCK=true
RAILKIT_MONTHLY_CAP=45

# Sign up at https://dashboard.razorpay.com/signup — Test Mode keys need no
# KYC/business docs. Settings -> API Keys -> Generate Test Key.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
